# ─────────────────────────────────────────────────────────────────────────────
# Jiezi Cloud — local environment variable template
#
# Copy this file to .env and edit as needed for local development.
#   cp .env.example .env
#
# .env is git-ignored and must NEVER be committed.
# Variables here are loaded by `dotenvy` at server startup.
#
# Naming convention:  JIEZI__<SECTION>__<KEY>
#   (double underscore maps to a nested TOML key)
# ─────────────────────────────────────────────────────────────────────────────

# Select environment tier (development | production | test)
JIEZI__ENVIRONMENT=development

# Database connection URL
# SQLite  (default dev):  sqlite:./data/jiezi-dev.db?mode=rwc
# Postgres (prod):        postgres://user:pass@localhost/jiezi
JIEZI__DATABASE__URL=sqlite:./data/jiezi-dev.db?mode=rwc

# JWT signing secret — must be at least 32 characters
# Generate a strong secret: openssl rand -hex 32
JIEZI__AUTH__JWT_SECRET=dev-only-secret-replace-in-production-1234

# HTTP server bind address and port (optional overrides)
# JIEZI__SERVER__HOST=127.0.0.1
# JIEZI__SERVER__PORT=8080

# Log level (optional override)
# JIEZI__TRACING__LEVEL=debug
