# Build artifacts
/target/

# Cargo lock is committed for binaries, ignored for libraries
# (we keep it since this workspace produces a binary)

# IDE & editor
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Env / secrets -- .env.example is intentionally committed as a template
.env
.env.local
.env.*.local
config/local.toml
*.pem
*.key

# Runtime data directory (SQLite databases, uploaded files)
/data/
!/data/.gitkeep

# Temporary files
build_output.txt
