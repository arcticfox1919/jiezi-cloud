# Build artifacts
/target/

# Cargo lock is committed for binaries, ignored for libraries
# (we keep it since this workspace produces a binary)

# IDE & editor
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Env / secrets -- .env.example is intentionally committed as a template
.env
.env.local
.env.*.local
config/local.toml
*.pem
*.key

# Runtime data directory.
# Git negation rules require expanding each level:
# ignore dir/* → un-ignore subdir → ignore subdir/* → un-ignore specific file
/data/*
!/data/.gitkeep
!/data/backups/
/data/backups/*
!/data/backups/db/
/data/backups/db/*
!/data/backups/db/.gitkeep

# Temporary files
build_output.txt

# Local Copilot instructions (personal, not shared with the team)
.github/copilot-instructions.md
